{
    "version": 8,
    "configurePresets": [
        {
            "name": "default",
            "binaryDir": "${sourceDir}/bin",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "DEBUG",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ],
    "workflowPresets": [
        {
            "name": "default",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "default"
                },
                {
                    "type": "test",
                    "name": "default"
                }
            ]
        }
    ]
}
